{
  "name": "oxlint-config-universe",
  "version": "0.1.0",
  "description": "Shared oxlint configs for internal Expo projects.",
  "keywords": [
    "expo",
    "oxlint",
    "oxlint-config"
  ],
  "homepage": "https://github.com/expo/oxlint-config-universe",
  "bugs": {
    "url": "https://github.com/expo/oxlint-config-universe/issues"
  },
  "license": "MIT",
  "author": "Expo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expo/oxlint-config-universe.git"
  },
  "files": [
    "README.md",
    "index.js",
    "index.d.ts",
    "default.js",
    "default.d.ts",
    "native.js",
    "native.d.ts",
    "node.js",
    "node.d.ts",
    "web.js",
    "web.d.ts",
    "shared",
    "!**/__tests__/**"
  ],
  "type": "module",
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./default": {
      "types": "./default.d.ts",
      "default": "./default.js"
    },
    "./native": {
      "types": "./native.d.ts",
      "default": "./native.js"
    },
    "./node": {
      "types": "./node.d.ts",
      "default": "./node.js"
    },
    "./web": {
      "types": "./web.d.ts",
      "default": "./web.js"
    },
    "./typescript-analysis": {
      "types": "./shared/typescript-analysis.d.ts",
      "default": "./shared/typescript-analysis.js"
    }
  },
  "scripts": {
    "build:types": "rm -f *.d.ts shared/*.d.ts && tsc -p tsconfig.build.json && oxfmt --write .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . -c oxlint.config.js",
    "test": "jest"
  },
  "devDependencies": {
    "@expo/spawn-async": "^1.7.2",
    "glob": "^13.0.6",
    "jest": "^29.7.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "7"
  },
  "peerDependencies": {
    "oxlint": ">=1.79.0",
    "oxlint-tsgolint": ">=7.0.2001"
  },
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "jest": {
    "testMatch": [
      "**/__tests__/*-test.js"
    ]
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
